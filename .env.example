# Lumeli — vzorčna konfiguracija (brez skrivnosti)
# Kopirajte v .env.local za lokalno uporabo.
# Realnih ključev ne zapisujte v Git.

NEXT_PUBLIC_SITE_NAME=Lumeli
NEXT_PUBLIC_SITE_URL=http://localhost:3000

