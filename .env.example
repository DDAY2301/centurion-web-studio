# ===========================================
# Centurion Web Studio - Environment Variables
# ===========================================
# Kopirajte ta datoteko v .env.local in izpolnite vrednosti

# Spletna stran URL ( za og:image in canonical URLs )
NEXT_PUBLIC_SITE_URL=https://centurion-web-studio.github.io
NEXT_PUBLIC_SITE_NAME=Centurion Web Studio

# Kontaktni API - SMTP nastavitve
# Za uporabo z email pošilanjem na produkciji
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=vaš-email@domene.com
SMTP_PASS=vaša-geslo

# API domene ( za CORS )
SITE_ORIGINS=https://centurion-web-studio.github.io,https://www.vaša-domena.com

# Admin žetone ( za upravljanje kupone )
ADMIN_TOKEN=vaš Tajni žeton

# Google Analytics ( opcijsko )
NEXT_PUBLIC_GA_ID=

# ===========================================
# Vite konfiguracija
# ===========================================
VITE_SITE_URL=https://centurion-web-studio.github.io

# ===========================================
# Opozorilo: Ne shranite taške vereb v javnem repozitoriju!
# ===========================================